# C1: eddy viscosity against its formula over a sweep of stratification.
# dT/dz runs from -0.005 K/m at the ground to +0.01 K/m at the top. The run takes
# 40 steps of 1e-3 s so that k and T stay at their initial values.
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 32.0 32.0 1024.0
geometry.is_periodic = 1 1 0
amr.n_cell           = 4 4 128
amr.blocking_factor  = 4
amr.max_level        = 0
time.stop_time       = 0.04
time.max_step        = -1
time.fixed_dt        = 0.001
time.plot_interval   = -1
time.checkpoint_interval = -1
incflo.physics       = ABL
incflo.density       = 1.0
incflo.gravity       = 0. 0. -9.81
incflo.velocity      = 10.0 0.0 0.0
incflo.verbose       = 0
incflo.constant_density = true
incflo.use_godunov   = true
incflo.godunov_type  = "ppm"
incflo.diffusion_type = 2
transport.model      = ConstTransport
transport.viscosity  = 1e-5
transport.laminar_prandtl = 0.7
transport.turbulent_prandtl = 0.333
transport.reference_temperature = 300.
turbulence.model     = KLAxell
TKE.source_terms     = KransAxell
ICNS.source_terms    = BoussinesqBuoyancy
ABL.kappa            = 0.41
ABL.normal_direction = 2
ABL.perturb_velocity = false
ABL.perturb_temperature = false
ABL.surface_roughness_z0 = 0.1
ABL.surface_temp_flux = 1.0e-4
ABL.init_tke         = 0.5
ABL.rans_1dprofile_file = "rans_1d.info"
ABL.meso_sponge_start = 1.0e9
ABL.temperature_heights = 0.0 16.0 32.0 48.0 64.0 80.0 96.0 112.0 128.0 144.0 160.0 176.0 192.0 208.0 224.0 240.0 256.0 272.0 288.0 304.0 320.0 336.0 352.0 368.0 384.0 400.0 416.0 432.0 448.0 464.0 480.0 496.0 512.0 528.0 544.0 560.0 576.0 592.0 608.0 624.0 640.0 656.0 672.0 688.0 704.0 720.0 736.0 752.0 768.0 784.0 800.0 816.0 832.0 848.0 864.0 880.0 896.0 912.0 928.0 944.0 960.0 976.0 992.0 1008.0 1024.0
ABL.temperature_values  = 300 299.921875 299.8475 299.776875 299.71 299.646875 299.5875 299.531875 299.48 299.431875 299.3875 299.346875 299.31 299.276875 299.2475 299.221875 299.2 299.181875 299.1675 299.156875 299.15 299.146875 299.1475 299.151875 299.16 299.171875 299.1875 299.206875 299.23 299.256875 299.2875 299.321875 299.36 299.401875 299.4475 299.496875 299.55 299.606875 299.6675 299.731875 299.8 299.871875 299.9475 300.026875 300.11 300.196875 300.2875 300.381875 300.48 300.581875 300.6875 300.796875 300.91 301.026875 301.1475 301.271875 301.4 301.531875 301.6675 301.806875 301.95 302.096875 302.2475 302.401875 302.56
DragForcing.bc_forcing_time_factor = 1.0e30
zlo.type = "slip_wall"
zhi.type = "slip_wall"
zlo.temperature_type = "fixed_gradient"
zlo.temperature = -0.005
zhi.temperature_type = "fixed_gradient"
zhi.temperature = 0.01
zlo.tke_type = "fixed_gradient"
zlo.tke = 0.0
zhi.tke_type = "fixed_gradient"
zhi.tke = 0.0
mac_proj.mg_atol = 1.0e-10
nodal_proj.mg_atol = 1.0e-10
incflo.post_processing = sampling
sampling.output_interval = 40
sampling.output_format = ascii
sampling.fields = tke temperature velocity mu_turb
sampling.labels = col
sampling.col.type = LineSampler
sampling.col.num_points = 128
sampling.col.start = 16.0 16.0 4.0
sampling.col.end   = 16.0 16.0 1020.0
